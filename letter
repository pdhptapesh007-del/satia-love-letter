<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#160e19"><title>نامه ای به ساتیای عزیزم</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap');
:root{--gold:#d8b778;--rose:#e6b5c6;--wine:#792849}
*{box-sizing:border-box}body{margin:0;min-height:100svh;overflow-x:hidden;font-family:Vazirmatn,Tahoma,sans-serif;color:#f9eaf0;background:radial-gradient(ellipse at 50% 0%,#51233b 0%,transparent 48%),radial-gradient(ellipse at 5% 90%,#32192b 0%,transparent 42%),linear-gradient(145deg,#100d15,#20121e 58%,#130e18);display:grid;place-items:center;padding:20px}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.12;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E")}
main{width:min(100%,650px);text-align:center;position:relative;z-index:1;padding:25px 8px 34px}.ornament{display:flex;align-items:center;justify-content:center;gap:12px;color:var(--gold);font-size:12px;letter-spacing:.15em;margin-bottom:16px}.ornament:before,.ornament:after{content:"";width:48px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}.ornament:after{transform:rotate(180deg)}
h1{font-size:clamp(1.8rem,6vw,2.8rem);line-height:1.5;margin:0;color:#fff0f2;font-weight:600}h1 span{color:var(--rose)}.subtitle{margin:12px auto 22px;max-width:450px;line-height:2;color:#cdb0bd;font-size:.94rem}
.envelope-wrap{height:275px;display:grid;place-items:center;perspective:1000px}.envelope{position:relative;width:min(84vw,355px);height:215px;cursor:pointer;filter:drop-shadow(0 25px 35px #0008);transition:transform .35s;outline:none}.envelope:hover{transform:translateY(-4px)}.back{position:absolute;inset:0;border:1px solid #e5b4c4;border-radius:4px;background:linear-gradient(135deg,#b65a79,#752746 70%,#4e1d38);box-shadow:inset 0 0 28px #f8dbe31a}
.letter{position:absolute;left:7%;width:86%;height:90%;bottom:4%;background:linear-gradient(145deg,#fffaf2,#f5e4e8);border:1px solid #e4c8c5;box-shadow:0 6px 25px #0003;border-radius:3px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:15px;transition:transform 1s cubic-bezier(.2,.8,.2,1);z-index:2;color:#773650}.letter b{font-size:1.8rem;color:#a34e6c;font-weight:400}.letter p{margin:4px 0;font-size:.95rem;line-height:1.8}.letter small{color:#9f7886;margin-top:6px}
.front{position:absolute;inset:0;z-index:4;overflow:hidden;border-radius:2px;pointer-events:none}.front:before{content:"";position:absolute;inset:0;background:linear-gradient(35deg,#9c4263 0 49.5%,transparent 50%),linear-gradient(-35deg,#c77b94 0 49.5%,transparent 50%);border-bottom:1px solid #edb9c9}.flap{position:absolute;left:0;right:0;top:0;height:61%;z-index:5;transform-origin:top;transition:transform .8s ease;filter:drop-shadow(0 3px 4px #2c0b1c66)}.flap:before{content:"";position:absolute;inset:0;background:linear-gradient(145deg,#d28ca4,#8b3156);clip-path:polygon(0 0,100% 0,50% 100%)}
.seal{position:absolute;z-index:6;left:50%;top:49%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 25%,#f9e5c0,#bb8a55 70%,#8b5b35);box-shadow:0 3px 12px #17081288,inset 0 0 0 1px #fff7;color:#fff3d8;font-size:1.3rem;transition:.25s}
.envelope.open .flap{transform:rotateX(180deg);z-index:1}.envelope.open .seal{opacity:0;transform:translate(-50%,-50%) scale(.5)}.envelope.open .letter{transform:translateY(-112px);z-index:3}
.hint{font-size:.9rem;color:#d7b3c2;margin:3px 0 22px}.btn{border:1px solid var(--gold);border-radius:3px;padding:12px 26px;font:500 1rem Vazirmatn,Tahoma,sans-serif;background:linear-gradient(135deg,#8c3459,#65233f);color:#fff6f5;box-shadow:0 10px 28px #0003;cursor:pointer;transition:.25s}.btn:hover{transform:translateY(-2px);background:linear-gradient(135deg,#a3466b,#75284a)}.footer{font-size:.78rem;color:#9d7c8d;margin-top:24px}
.petal{position:fixed;top:-35px;z-index:0;pointer-events:none;animation:fall linear forwards;opacity:.65;filter:drop-shadow(0 0 5px #edafc8)}@keyframes fall{to{transform:translate3d(var(--drift),110vh,0) rotate(620deg);opacity:0}}.spark{position:fixed;pointer-events:none;z-index:0;animation:twinkle 3.2s ease-in-out infinite alternate;color:#e7c98f;font-size:13px;text-shadow:0 0 12px #c88a9f}@keyframes twinkle{from{opacity:.18;transform:scale(.7)}to{opacity:.85;transform:scale(1.25)}}
.overlay{position:fixed;inset:0;background:#08060cc9;backdrop-filter:blur(12px);z-index:10;display:none;place-items:center;padding:14px}.overlay.show{display:grid}.card{position:relative;width:min(100%,600px);max-height:90svh;overflow:auto;background:linear-gradient(145deg,#fffaf3,#f7e9ec);border:1px solid #d8b88d;border-radius:4px;padding:28px clamp(20px,5vw,42px);box-shadow:0 30px 100px #0008;text-align:center;color:#623147;animation:appear .55s cubic-bezier(.2,.8,.2,1)}.card:before{content:"";position:absolute;inset:8px;border:1px solid #dfc6bd;pointer-events:none}@keyframes appear{from{opacity:0;transform:translateY(22px) scale(.97)}to{opacity:1;transform:none}}.close{position:sticky;top:0;float:left;margin-top:-10px;margin-left:-8px;background:#eed8dd;border:1px solid #d8b8c1;width:34px;height:34px;color:#71344d;font-size:1.2rem;cursor:pointer;z-index:2}.card .heart{font-size:1.7rem;color:#a34e6c;position:relative}.card h2{position:relative;color:#823451;margin:8px 0 22px;font-size:1.3rem;font-weight:600}.letter-text{position:relative;white-space:pre-wrap;line-height:2.15;text-align:right;font-size:1rem;color:#583143;overflow-wrap:anywhere}.signature{position:relative;margin-top:23px;color:#9a4e6b;font-weight:600}
@media(max-width:420px){body{padding:14px}main{padding-top:18px}.envelope-wrap{height:245px}.envelope{height:185px}.envelope.open .letter{transform:translateY(-96px)}.subtitle{font-size:.9rem}.letter-text{font-size:.92rem;line-height:2.05}.card{padding:24px 19px}.card:before{inset:6px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<main>
<div class="ornament">✦　با عشق، برای تو　✦</div>
<h1>برای <span>ساتیای عزیزم</span></h1>
<p class="subtitle">بعضی حرف‌ها رو نمی‌شه ساده گفت؛<br>باید با تمام قلب نوشت… ♡</p>
<div class="envelope-wrap"><div class="envelope" id="envelope" role="button" tabindex="0" aria-label="باز کردن نامه">
<div class="back"></div><div class="letter"><b>♡</b><p>ساتیای عزیزم،<br>چند خط از قلبم برای تو…</p><small>با تمام عشق، پرهام</small></div><div class="front"></div><div class="flap"></div><div class="seal">♥</div>
</div></div>
<p class="hint" id="hint">برای باز کردن نامه، روی پاکت کلیک کن</p>
<button class="btn" id="openBtn">باز کردن نامه　♡</button>
<p class="footer">یک نامه‌ی کوچک، با احساسی بزرگ</p>
</main>
<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="letterTitle"><article class="card">
<button class="close" id="closeBtn" aria-label="بستن">×</button><div class="heart">✧　♡　✧</div><h2 id="letterTitle">نامه ای به ساتیای عزیزم</h2>
<div class="letter-text">تو هیچوقت برام مثل یه دوست دختر نبودی . تو برام فراتر از هر چیزی زیر این سقف اسمون بودی . من معنی اولین عشق رو باتو تجربه کردم و تا ابد میخوام که معنی اخرش هم تو باشی و براش حاضرم هر کاری بکنم . اره اکثر موقه ها من باعث ناراحتی و دلخوریت شدم و شاید خاطراتی گذاشتم که نتونی فراموششون کنی . اره من یه زمانی از زندگیم که بهش میگن گذشتم کار های بدی انجام دادم که همیشه منو اذیت میکنه . توی زندگیم با انسان های زیادی معاشرت کردم اما هیچ کدومشون مثل چشای مرواریدی خوشگلت نتونستم دلمو بلرزونن و حتی شاید بترسونن . من بعد دیدن عکسات دوباره دلم لرزید و تونستم به کمکش گرگمو رام کنم یعین تو این کارو کردی ساتیام . به خاطر تمام کارهایی که باعث ناراحتی تو شدن معذرت میخوام و بدون و مطمئن باش که میخوام با تو یه زندگی بی نقص بسازم و شدیدا به حمایتت نیاز دارم . بهت قول میدم یه قوب پرهامی و دلمو ضامنش میکنم .از طرف پسری که همیشه عاشقت بود و میمونه . پرهام</div>
<div class="signature">با عشق، پرهام ♡</div>
</article></div>
<script>
const envelope=document.getElementById('envelope'),overlay=document.getElementById('overlay'),hint=document.getElementById('hint'),openBtn=document.getElementById('openBtn');let isOpen=false;
function openLetter(){if(!isOpen){isOpen=true;envelope.classList.add('open');hint.textContent='نامه‌ات باز شد… ♡';openBtn.textContent='خواندن نامه دوباره';setTimeout(()=>overlay.classList.add('show'),850)}else overlay.classList.add('show')}
function closeLetter(){overlay.classList.remove('show')}
envelope.addEventListener('click',openLetter);envelope.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openLetter()}});openBtn.addEventListener('click',openLetter);document.getElementById('closeBtn').addEventListener('click',closeLetter);overlay.addEventListener('click',e=>{if(e.target===overlay)closeLetter()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeLetter()});
const symbols=['✿','♡','❀','✧','🌹'];function petal(){const el=document.createElement('span');el.className='petal';el.textContent=symbols[Math.floor(Math.random()*symbols.length)];el.style.left=Math.random()*100+'vw';el.style.fontSize=(11+Math.random()*15)+'px';el.style.setProperty('--drift',(Math.random()*160-80)+'px');el.style.animationDuration=(9+Math.random()*10)+'s';document.body.appendChild(el);setTimeout(()=>el.remove(),20000)}for(let i=0;i<10;i++)setTimeout(petal,i*450);setInterval(petal,1150);for(let i=0;i<14;i++){const s=document.createElement('span');s.className='spark';s.textContent='✧';s.style.left=Math.random()*100+'vw';s.style.top=Math.random()*100+'vh';s.style.animationDelay=Math.random()*3+'s';document.body.appendChild(s)}
</script>
</body></html>
